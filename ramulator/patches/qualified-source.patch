+//   RAMULATOR_PARSE_PARAM(m_ipc, int, "ipc").default_val(4);
+#define RAMULATOR_PARSE_PARAM(var, type, name) \
+  var = Ramulator::ParamReader<type> {         \
+    m_config, name, m_name                     \
+  }
