+      s_num_read_reqs_served++;
+      if (req.callback) {
+        req.callback(req);
+      }
+    }
+  }
+
+  Clk_t idle_ticks() override {
+    if (m_pending.empty()) {
+      return std::numeric_limits<Clk_t>::max();
+    }
+    Clk_t next = m_pending.top().depart;
+    return (next > m_clk + 1) ? (next - m_clk - 1) : 0;
+  }
