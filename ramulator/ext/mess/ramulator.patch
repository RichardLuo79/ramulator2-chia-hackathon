+// Ramulator input compatibility only. Prediction and feedback routines below
+// are unchanged from the pinned standalone implementation (see UPSTREAM.json).
+static void validateCurves(const CurveFile& file) {
+    if (file.measuredChannels == 0 || file.curves.empty())
+        throw std::runtime_error("MeSS: expected positive measuredChannels and nonempty curves");
+    bool seen[101] = {};
+    for (const auto& curve : file.curves) {
+        const int pct = curve.readPercentage;
+        if (pct < 0 || pct > 100 || seen[pct] || curve.points.empty())
+            throw std::runtime_error("MeSS: invalid/duplicate read percentage or empty curve");
+        seen[pct] = true;
+        double previous = std::numeric_limits<double>::infinity();
+        for (const auto& [bw, latency] : curve.points) {
+            if (!std::isfinite(bw) || bw < 0 || bw >= previous ||
+                !std::isfinite(latency) || latency <= 0)
+                throw std::runtime_error("MeSS: expected finite positive latency and strictly descending bandwidth");
+            previous = bw;
+        }
+    }
+}
+
+static CurveFile loadLegacyCurves(const char* data, size_t size) {
+    // Legacy calibration: read_pct bandwidth_GBps latency_ns, one point/line.
+    // These curves were measured for one channel. Do not fit or alter points.
+    std::map<int, CurveEntry> curves;
+    std::istringstream input(std::string(data, size));
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream fields(line);
+        fields >> std::ws;
+        if (fields.eof()) continue;
+        int pct;
+        double bw, latency;
+        if (!(fields >> pct >> bw >> latency))
+            throw std::runtime_error("MeSS: expected read_pct bandwidth_GBps latency_ns");
+        fields >> std::ws;
+        if (!fields.eof() || pct < 0 || pct > 100 || !std::isfinite(bw) ||
+            bw < 0 || !std::isfinite(latency) || latency <= 0)
+            throw std::runtime_error("MeSS: invalid legacy calibration point");
+        auto& curve = curves[pct];
+        curve.readPercentage = pct;
+        curve.points.emplace_back(bw * 1000.0, latency);  // GB/s -> MB/s
+    }
+    CurveFile file;
+    file.measuredChannels = 1;
+    for (auto& [pct, curve] : curves) {
+        std::sort(curve.points.begin(), curve.points.end(),
+                  [](const auto& a, const auto& b) { return a.first > b.first; });
+        file.curves.push_back(std::move(curve));
+    }
+    validateCurves(file);
+    return file;
+}
